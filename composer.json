{
    "name": "betalabs/engine-phpsdk",
    "description": "SDK for Engine",
    "authors": [],
    "require": {
        "php": "^8.2",
        "php-di/php-di": "^7.0",
        "nesbot/carbon": "^2.26 || ^3.0",
        "aura/router": "^3.1",
        "guzzlehttp/guzzle": "^7.0",
        "laminas/laminas-diactoros": "^3.6",
        "symfony/http-kernel": "^5.4 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6.2"
    },
    "autoload": {
        "psr-4": {
            "Betalabs\\Engine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Betalabs\\Engine\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}